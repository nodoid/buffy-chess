<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 6/7's iOS shell: same shared sources as Android; adds the scene
    delegate bootstrap and an iPhone storage adapter. Packaging is chapter 12.
    Targets iPhone/iPad on iOS 18+.

    macOS is NOT built from here. Mac Catalyst would need MonoGame assets for
    net10.0-maccatalyst, and MonoGame.Framework.iOS ships only net8.0-ios17.5,
    so a Catalyst build has no MonoGame to link. The Mac gets the DesktopGL
    shell in src/Chess.Desktop, wrapped as a .app by tools/package-macos.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <RootNamespace>Chess.iOS</RootNamespace>
    <AssemblyName>Chess.iOS</AssemblyName>
    <Nullable>disable</Nullable>
    <ApplicationTitle>Buffy Chess</ApplicationTitle>
    <ApplicationId>uk.co.chessbook.BuffyChess</ApplicationId>
    <ApplicationVersion>1.0</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <CodesignKey>iPhone Developer</CodesignKey>
    <!-- Simulator builds sign ad hoc in BrandAndSignBundle below, because the
         iCloud FileProvider daemon re-tags the bundle faster than the SDK's
         codesign step can run; clearing and signing in one shell keeps the
         window closed. Device builds keep the SDK's real signing. -->
    <EnableCodeSigning Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))">false</EnableCodeSigning>
    <!-- Default (SDK) trimming plus explicit roots: SceneDelegate reflects into
         two private members of MonoGame.Framework that must survive (roots.xml). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.2.1105" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="roots.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chess.Core\Chess.Core.csproj" />
  </ItemGroup>

  <!-- App icon set + launch image, generated by tools/icons.py. LogicalName
       flattens them to the bundle root because CFBundleIconFiles looks up
       files (and their @2x/@3x variants) directly in the .app. -->
  <ItemGroup>
    <BundleResource Include="Assets\*.png">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </BundleResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Chess.Desktop\ChessGame.cs" Link="Shared\ChessGame.cs" />
    <Compile Include="..\..\src\Chess.Desktop\Rendering\*.cs" Link="Shared\Rendering\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chess.Desktop\Ui\*.cs" Link="Shared\Ui\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chess.Desktop\Input\*.cs" Link="Shared\Input\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chess.Desktop\Rendering3D\*.cs" Link="Shared\Rendering3D\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Branding and bootstrap keys are merged into the SDK-generated Info.plist
       *before* the bundle is signed: PartialAppManifest is the supported hook,
       whereas patching a signed .app with PlistBuddy would invalidate the
       signature (and did, on device builds). Contents: Info.additions.plist. -->
  <ItemGroup>
    <PartialAppManifest Include="Info.additions.plist" />
  </ItemGroup>

  <!-- The build tree lives under an iCloud-managed Documents folder; the
       FileProvider daemon tags freshly staged bundles with com.apple.FinderInfo
       and com.apple.fileprovider.fpfs metadata that codesign rejects
       ('resource fork ... detritus'). The daemon re-adds them within a second,
       so clearing and signing are chained in one shell command: the signature
       lands inside the window. The SDK's own codesign is off for simulator
       builds (EnableCodeSigning above) so there is no race and no abort. -->
  <!-- Same daemon, different step: on DEVICE builds the SDK's own
       _CodesignAppBundle target runs codesign, so a retry loop cannot be ours.
       Clearing the attributes immediately before it closes most of the window. -->
  <Target Name="ClearXattrsBeforeCodesign" BeforeTargets="_CodesignAppBundle">
    <Exec Command="xattr -cr '$(AppBundleDir)' || true" IgnoreExitCode="true" />
  </Target>

  <Target Name="SignSimulatorBundle" AfterTargets="Build"
          Condition="'$(OutputPath)$(AssemblyName).app/Info.plist' != '' And Exists('$(OutputPath)$(AssemblyName).app/Info.plist') And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))">
    <Exec Command="xattr -cr '$(OutputPath)$(AssemblyName).app' &amp;&amp; find '$(OutputPath)$(AssemblyName).app' -name '*.dylib' -exec codesign --force --sign - '{}' ';' &amp;&amp; for i in 1 2 3 4 5; do xattr -cr '$(OutputPath)$(AssemblyName).app'; if codesign --force --sign - '$(OutputPath)$(AssemblyName).app'; then break; fi; sleep 1; done" />
  </Target>

</Project>
