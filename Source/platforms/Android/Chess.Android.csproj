<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 6's Android shell. It re-uses the exact shared shell sources (packaging is Chapter 12's job),
    from the desktop app (camera,BoardRenderer, atlas, UI) and only adds the
    Android bootstrap: an Activity that hosts the MonoGame window, touch-to-
    gesture input mapping and Android storage implementation.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>32.0</SupportedOSPlatformVersion>
    <ApplicationId>uk.co.chessbook.BuffyChess</ApplicationId>
    <!-- android:label for the whole <application>. The launcher shows the
         Activity's [Activity(Label = ...)], but Settings, the recents sheet and
         the package installer read this one - and without it they show the
         package id. The property is ApplicationTitle: "ApplicationLabel" is
         accepted by MSBuild and silently ignored. -->
    <ApplicationTitle>Buffy Chess</ApplicationTitle>
    <!-- ApplicationVersion is the integer versionCode the store requires to
         increase on every upload; ApplicationDisplayVersion is what the player
         (and the Play Console listing) sees. Conflating the two is the mistake
         that made this book's first Release build fail with XA0003. -->
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidVersionCode>1</AndroidVersionCode>
    <RootNamespace>Chess.Android</RootNamespace>
    <AssemblyName>Chess.Android</AssemblyName>
    <Nullable>disable</Nullable>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.2.1105" />
  </ItemGroup>

  <!-- Launcher icons (generated by tools/icons.py) and the Theme.Splash
       window background drawn before the first MonoGame frame. -->
  <ItemGroup>
    <AndroidResource Include="Resources\mipmap-*\*.png" />
    <AndroidResource Include="Resources\drawable\*.xml" />
    <AndroidResource Include="Resources\drawable-nodpi\*.png" />
    <AndroidResource Include="Resources\values\*.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chess.Core\Chess.Core.csproj" />
  </ItemGroup>

  <!-- Share the shell; the desktop-only bootstrap is replaced by Activity.cs -->
  <ItemGroup>
    <Compile Include="..\..\src\Chess.Desktop\ChessGame.cs" Link="Shared\ChessGame.cs" />
    <Compile Include="..\..\src\Chess.Desktop\Rendering\*.cs" Link="Shared\Rendering\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chess.Desktop\Ui\*.cs" Link="Shared\Ui\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chess.Desktop\Input\*.cs" Link="Shared\Input\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chess.Desktop\Rendering3D\*.cs" Link="Shared\Rendering3D\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
