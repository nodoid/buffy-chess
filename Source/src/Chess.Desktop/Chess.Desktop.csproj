<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Chess.Desktop</RootNamespace>
    <AssemblyName>Chess.Desktop</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Windows shell's icon (generated by tools/icons.py). csc embeds it
         as a Win32 resource, so Explorer, the taskbar and Alt-Tab all show the
         pawn plate instead of the default .NET window. Other platforms ignore
         the .ico and use their own icon assets. -->
    <ApplicationIcon>..\..\Assets\Branding\Chess.Desktop.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness, plus the "no elevation" and Windows 10/11
         compatibility declarations. See app.manifest and chapter 10. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Buffy Chess</Product>
    <Company>Chess Game Book</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chess.Core\Chess.Core.csproj" />
  </ItemGroup>

</Project>
